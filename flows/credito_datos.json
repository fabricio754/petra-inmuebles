{
  "version": "7.3",
  "screens": [
    {
      "id": "DATOS",
      "title": "Massi · Paso 2 de 2",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_datos",
            "children": [
              {
                "type": "TextHeading",
                "text": "🎉 ¡Último paso!"
              },
              {
                "type": "TextBody",
                "text": "Tu inmueble cumple con los requisitos. Solo necesitamos tus datos para enviar la solicitud a Sureti."
              },
              {
                "type": "TextSubheading",
                "text": "👤 Propietario del inmueble"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "tipo_persona",
                "label": "Tipo",
                "description": "¿El dueño es persona natural o empresa?",
                "required": true,
                "data-source": [
                  { "id": "NATURAL", "title": "Persona natural" },
                  { "id": "JURIDICA", "title": "Empresa / jurídica" }
                ]
              },
              {
                "type": "TextInput",
                "name": "nombre",
                "label": "Nombre",
                "input-type": "text",
                "required": true,
                "helper-text": "Como aparece en la cédula"
              },
              {
                "type": "TextInput",
                "name": "cedula",
                "label": "Cédula o NIT",
                "input-type": "number",
                "required": true,
                "helper-text": "Solo números, sin puntos"
              },
              {
                "type": "TextInput",
                "name": "edad",
                "label": "Edad",
                "input-type": "number",
                "required": true,
                "helper-text": "Años cumplidos"
              },
              {
                "type": "TextSubheading",
                "text": "💰 Tu crédito"
              },
              {
                "type": "Dropdown",
                "name": "objetivo",
                "label": "Objetivo del crédito",
                "required": true,
                "data-source": [
                  { "id": "OBJ_CAPITAL", "title": "Capital de trabajo" },
                  { "id": "OBJ_DEUDAS", "title": "Pagar deudas" },
                  { "id": "OBJ_INVERSION", "title": "Inversión" },
                  { "id": "OBJ_GASTOS", "title": "Gastos personales" },
                  { "id": "OBJ_OTRO", "title": "Otro" }
                ]
              },
              {
                "type": "TextInput",
                "name": "email",
                "label": "Correo",
                "input-type": "email",
                "required": true,
                "helper-text": "Para enviarte novedades de tu solicitud"
              },
              {
                "type": "TextCaption",
                "text": "🔒 Al enviar, autorizas compartir estos datos con Sureti para estudiar tu crédito."
              },
              {
                "type": "Footer",
                "label": "Enviar solicitud",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "tipo_persona": "${form.tipo_persona}",
                    "nombre": "${form.nombre}",
                    "cedula": "${form.cedula}",
                    "email": "${form.email}",
                    "objetivo": "${form.objetivo}",
                    "edad": "${form.edad}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
