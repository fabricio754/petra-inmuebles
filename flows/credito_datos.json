{
  "version": "7.3",
  "screens": [
    {
      "id": "DATOS",
      "title": "Paso 2 de 2",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_datos",
            "children": [
              {
                "type": "TextHeading",
                "text": "Datos del propietario"
              },
              {
                "type": "TextBody",
                "text": "Con esto enviamos tu solicitud a Sureti para que estudie tu crédito."
              },
              {
                "type": "TextInput",
                "name": "nombre",
                "label": "Nombre completo",
                "input-type": "text",
                "required": true,
                "helper-text": "Como aparece en la cédula"
              },
              {
                "type": "TextInput",
                "name": "cedula",
                "label": "Cédula",
                "input-type": "number",
                "required": true,
                "helper-text": "Solo números, sin puntos"
              },
              {
                "type": "TextInput",
                "name": "email",
                "label": "Correo electrónico",
                "input-type": "email",
                "required": true,
                "helper-text": "Aquí te enviaremos novedades de tu solicitud"
              },
              {
                "type": "TextInput",
                "name": "direccion",
                "label": "Dirección",
                "input-type": "text",
                "required": true,
                "helper-text": "Ej: Cra 45 # 80-20"
              },
              {
                "type": "TextInput",
                "name": "apto",
                "label": "Apto / interior",
                "input-type": "text",
                "required": false,
                "helper-text": "Opcional. Ej: Apto 302, Torre 2"
              },
              {
                "type": "TextInput",
                "name": "barrio",
                "label": "Barrio",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "ciudad",
                "label": "Ciudad",
                "required": true,
                "data-source": [
                  {
                    "id": "BOGOTA",
                    "title": "Bogotá"
                  },
                  {
                    "id": "MEDELLIN",
                    "title": "Medellín"
                  },
                  {
                    "id": "BARRANQUILLA",
                    "title": "Barranquilla"
                  },
                  {
                    "id": "CARTAGENA",
                    "title": "Cartagena"
                  },
                  {
                    "id": "SANTA_MARTA",
                    "title": "Santa Marta"
                  },
                  {
                    "id": "CUCUTA",
                    "title": "Cúcuta"
                  },
                  {
                    "id": "OTRA",
                    "title": "Otra"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Al enviar, autorizas compartir estos datos con Sureti para estudiar tu crédito."
              },
              {
                "type": "Footer",
                "label": "Enviar solicitud",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "nombre": "${form.nombre}",
                    "cedula": "${form.cedula}",
                    "email": "${form.email}",
                    "direccion": "${form.direccion}",
                    "apto": "${form.apto}",
                    "barrio": "${form.barrio}",
                    "ciudad": "${form.ciudad}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
