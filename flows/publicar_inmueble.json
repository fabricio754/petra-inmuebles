{
  "version": "7.3",
  "screens": [
    {
      "id": "FORM",
      "title": "Publicar inmueble",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_publicar",
            "children": [
              {
                "type": "TextInput",
                "name": "apto",
                "label": "Apartamento",
                "input-type": "text",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "habitaciones",
                "label": "Habitaciones",
                "input-type": "number",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "banos",
                "label": "Baños",
                "input-type": "number",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "area",
                "label": "Área en m²",
                "input-type": "number",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "precio",
                "label": "Precio",
                "input-type": "number",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "operacion",
                "label": "Operación",
                "required": true,
                "data-source": [
                  {
                    "id": "ARRIENDO",
                    "title": "Arriendo"
                  },
                  {
                    "id": "VENTA",
                    "title": "Venta"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Publicar",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "apto": "${form.apto}",
                    "habitaciones": "${form.habitaciones}",
                    "banos": "${form.banos}",
                    "area": "${form.area}",
                    "precio": "${form.precio}",
                    "operacion": "${form.operacion}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
