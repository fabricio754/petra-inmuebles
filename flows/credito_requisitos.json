{
  "version": "7.3",
  "screens": [
    {
      "id": "REQUISITOS",
      "title": "Paso 1 de 2",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_requisitos",
            "children": [
              {
                "type": "TextHeading",
                "text": "Revisemos tu inmueble"
              },
              {
                "type": "TextBody",
                "text": "Son 4 preguntas rápidas. Si todo está bien, el siguiente paso son los datos del propietario."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "hipoteca",
                "label": "Hipoteca o embargo",
                "description": "¿El inmueble tiene hipoteca o embargo vigente?",
                "required": true,
                "data-source": [
                  {
                    "id": "SI",
                    "title": "Sí"
                  },
                  {
                    "id": "NO",
                    "title": "No"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "patrimonio",
                "label": "Patrimonio de familia",
                "description": "¿Tiene patrimonio de familia con hijos menores de edad?",
                "required": true,
                "data-source": [
                  {
                    "id": "SI",
                    "title": "Sí"
                  },
                  {
                    "id": "NO",
                    "title": "No"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "edad",
                "label": "Edad del propietario",
                "description": "¿El propietario tiene más de 75 años?",
                "required": true,
                "data-source": [
                  {
                    "id": "SI",
                    "title": "Sí"
                  },
                  {
                    "id": "NO",
                    "title": "No"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "paz_salvo",
                "label": "Pagos al día",
                "description": "¿Estás dispuesto a ponerte al día con predial, servicios y administración?",
                "required": true,
                "data-source": [
                  {
                    "id": "SI",
                    "title": "Sí"
                  },
                  {
                    "id": "NO",
                    "title": "No"
                  }
                ]
              },
              {
                "type": "TextCaption",
                "text": "Tus respuestas solo se usan para evaluar tu solicitud."
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "hipoteca": "${form.hipoteca}",
                    "patrimonio": "${form.patrimonio}",
                    "edad": "${form.edad}",
                    "paz_salvo": "${form.paz_salvo}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
