{
  "version": "7.3",
  "screens": [
    {
      "id": "REQUISITOS",
      "title": "Massi · Paso 1 de 2",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_requisitos",
            "children": [
              {
                "type": "TextHeading",
                "text": "🏠 Tu inmueble"
              },
              {
                "type": "TextBody",
                "text": "Para evaluar si podemos ayudarte con el crédito, necesitamos saber dónde queda y confirmar algunos requisitos. Son 5 preguntas cortas."
              },
              {
                "type": "TextSubheading",
                "text": "📍 Dónde queda"
              },
              {
                "type": "TextInput",
                "name": "direccion",
                "label": "Dirección",
                "input-type": "text",
                "required": true,
                "helper-text": "Ej: Cra 45 # 80-20"
              },
              {
                "type": "TextInput",
                "name": "apto",
                "label": "Apto / interior (opcional)",
                "input-type": "text",
                "required": false,
                "helper-text": "Ej: Apto 302, Torre 2"
              },
              {
                "type": "TextInput",
                "name": "barrio",
                "label": "Barrio",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "ciudad",
                "label": "Ciudad",
                "required": true,
                "data-source": [
                  { "id": "BARRANQUILLA", "title": "Barranquilla" },
                  { "id": "BOGOTA", "title": "Bogotá" },
                  { "id": "CAJICA", "title": "Cajicá" },
                  { "id": "CARTAGENA", "title": "Cartagena" },
                  { "id": "CHIA", "title": "Chía" },
                  { "id": "CUCUTA", "title": "Cúcuta" },
                  { "id": "MEDELLIN", "title": "Medellín" },
                  { "id": "SANTA_MARTA", "title": "Santa Marta" },
                  { "id": "ZIPAQUIRA", "title": "Zipaquirá" },
                  { "id": "OTRA", "title": "Otra" }
                ]
              },
              {
                "type": "Dropdown",
                "name": "estrato",
                "label": "Estrato",
                "required": true,
                "data-source": [
                  { "id": "1", "title": "1" },
                  { "id": "2", "title": "2" },
                  { "id": "3", "title": "3" },
                  { "id": "4", "title": "4" },
                  { "id": "5", "title": "5" },
                  { "id": "6", "title": "6" }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "es_ph",
                "label": "¿Es un conjunto o edificio?",
                "description": "Propiedad horizontal (comparte zonas comunes, administración).",
                "required": true,
                "data-source": [
                  { "id": "SI", "title": "Sí" },
                  { "id": "NO", "title": "No" }
                ]
              },
              {
                "type": "TextSubheading",
                "text": "✅ Requisitos del crédito"
              },
              {
                "type": "TextBody",
                "text": "Son 4 preguntas rápidas para confirmar que el inmueble aplica."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "hipoteca",
                "label": "¿Tiene hipoteca o embargo?",
                "required": true,
                "data-source": [
                  { "id": "SI", "title": "Sí" },
                  { "id": "NO", "title": "No" }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "patrimonio",
                "label": "¿Afectación a patrimonio de familia?",
                "description": "Si hay hijos menores, no podrás venderlo libremente. Lo ves en las escrituras o en el certificado de tradición.",
                "required": true,
                "data-source": [
                  { "id": "SI", "title": "Sí" },
                  { "id": "NO", "title": "No" },
                  { "id": "NO_SE", "title": "No sé" }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "edad",
                "label": "¿Propietario mayor de 75 años?",
                "required": true,
                "data-source": [
                  { "id": "SI", "title": "Sí" },
                  { "id": "NO", "title": "No" }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "paz_salvo",
                "label": "¿Puedes ponerte al día con pagos pendientes?",
                "description": "Predial, servicios públicos y administración.",
                "required": true,
                "data-source": [
                  { "id": "SI", "title": "Sí" },
                  { "id": "NO", "title": "No" }
                ]
              },
              {
                "type": "TextSubheading",
                "text": "💵 Valor del inmueble"
              },
              {
                "type": "TextInput",
                "name": "avaluo",
                "label": "Avalúo comercial (COP)",
                "input-type": "number",
                "required": true,
                "helper-text": "Lo que crees que vale tu inmueble en el mercado. Ej: 350000000"
              },
              {
                "type": "TextCaption",
                "text": "🔒 Tus respuestas solo se usan para evaluar tu solicitud."
              },
              {
                "type": "Footer",
                "label": "Continuar al paso 2",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "direccion": "${form.direccion}",
                    "apto": "${form.apto}",
                    "barrio": "${form.barrio}",
                    "ciudad": "${form.ciudad}",
                    "estrato": "${form.estrato}",
                    "es_ph": "${form.es_ph}",
                    "hipoteca": "${form.hipoteca}",
                    "patrimonio": "${form.patrimonio}",
                    "edad": "${form.edad}",
                    "paz_salvo": "${form.paz_salvo}",
                    "avaluo": "${form.avaluo}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
