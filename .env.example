# Copia este archivo a ".env" y completa los valores cuando tengas
# la app de Meta creada (ver README, Fase 2).
# Mientras estas variables no existan, el sistema corre en DRY-RUN
# (imprime en consola lo que enviaría, no llama a la API real).

META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=petra-verify-token
META_TEST_NUMBER=
PORT=3000

# Google Sheets (almacenamiento permanente). Si GOOGLE_SHEET_ID está vacío,
# el bot usa los archivos JSON de data/ (modo local).
GOOGLE_SHEET_ID=
# Ruta de la llave JSON de la cuenta de servicio. En Render se sube como
# Secret File "google-credentials.json" y queda en esta ruta por defecto.
GOOGLE_CREDENTIALS_FILE=/etc/secrets/google-credentials.json

# PostgreSQL (producción). Si existe, tiene prioridad sobre Google Sheets.
# En Render: usar la "Internal Database URL" de massi-db.
DATABASE_URL=

# Formularios de WhatsApp (Flows) del crédito.
META_FLOW_REQUISITOS_ID=
META_FLOW_DATOS_ID=
META_FLOWS_MODE=draft

# Captación (Hito 7). Clave que usa la extensión "Enviar a Massi".
CAPTURA_TOKEN=
# Plantilla de apertura aprobada por Meta y su idioma (código de Meta, ej. es_CO o es).
META_PLANTILLA_APERTURA=
META_PLANTILLA_IDIOMA=es_CO
# Envío automático (Ley 2300: L-V 7-19, sáb 8-15, sin domingos ni festivos).
ENVIO_AUTOMATICO=false
ENVIO_LIMITE_DIARIO=20
# Solo se escribe a contactos capturados desde esta fecha (AAAA-MM-DD, hora Colombia).
ENVIO_DESDE=

# ── Sureti ───────────────────────────────────────────────────────────────────
# Credenciales del portal de agentes (agentes.sureti.co).
# Sin estas variables, sureti.py corre en dry-run.
SURETI_EMAIL=
SURETI_PASSWORD=

# ── Scraper ──────────────────────────────────────────────────────────────────
SCRAPER_ENABLED=false
SCRAPER_MAX_POR_PORTAL=300
# 2captcha para resolver captchas en portales inmobiliarios.
TWOCAPTCHA_API_KEY=

# ── Documentos automáticos ───────────────────────────────────────────────────
# Credenciales para el portal SNR (certificados de tradición).
SNR_USER=
SNR_PASS=
# Directorio donde se guardan archivos descargados y enviados por el vendedor.
MEDIA_DIR=/var/data/media

# ── Parser de documentos (visión) ────────────────────────────────────────────
# Si está vacío, el fallback de visión se omite silenciosamente.
ANTHROPIC_API_KEY=
